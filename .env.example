# vLLM (OpenAI-compatible /v1/chat/completions) — the only LLM provider.
# Point this at your served capable code model. When unreachable, the service
# degrades gracefully (rule-only / neutral responses), it does not error.
VLLM_BASE_URL=http://localhost:8001
VLLM_MODEL=Qwen/Qwen2.5-Coder-32B-Instruct
# VLLM_API_KEY=            # if your vLLM server requires a bearer token
LLM_TIMEOUT_SECONDS=30

# Optional shared bearer secret for backend -> AI calls. Must match the
# backend's AI_SERVICE_API_KEY. Unset = open (local/dev).
# SERVICE_API_KEY=

LOG_LEVEL=INFO
MAX_SOURCE_CODE_CHARS=20000
PROMPT_MAX_CHARS=12000
RULE_ENGINE_ENABLED=true
MAX_CONCEPT_GAPS=8
MAX_USED_ITEMS=32
